# =============================================================================
# OhMyFreezer — Variables de entorno requeridas
# Copiá este archivo como .env y rellená los valores reales.
# NUNCA subas el .env con valores reales al repositorio.
# =============================================================================

# --- Base de datos ---
BD_URL=jdbc:mysql://<HOST>:3306/ohmyfreezer?useSSL=false&serverTimezone=Europe/Madrid
BD_USER=<usuario_db>
BD_PASSWORD=<contrasenya_db>

# --- JWT ---
# Mínimo 32 caracteres, aleatorio, secreto.
JWT_SECRET_CODE=<cadena_aleatoria_muy_larga_y_segura>

# --- Código de registro de jefe de cocina ---
# Los usuarios que quieran registrarse como jefes deben conocer este código.
BUSSINES_LOGIC_CODE=<codigo_secreto_jefe>

# --- Email (Gmail) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<tu_email@gmail.com>
# Contraseña de aplicación de Gmail (no la contraseña de tu cuenta).
# Generala en: https://myaccount.google.com/apppasswords
SPRING_MAIL_PASSWORD=<app_password_gmail>

# --- CORS ---
# Dominio(s) del frontend separados por coma. Sin barra final.
# Ejemplo producción: https://ohmyfreezer.tudominio.com
# Ejemplo desarrollo: http://localhost:3000,http://localhost:8081
ALLOWED_ORIGINS=http://localhost:3000

# --- Perfil Spring ---
# Usá "dev" en local y "prod" en el servidor.
SPRING_PROFILES_ACTIVE=dev
