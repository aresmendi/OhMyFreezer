# ============================================================
# OhMyFreezer — .gitignore raíz
# Cubre: Spring Boot (backend) + Flutter (frontend)
# ============================================================

# ─── SISTEMA OPERATIVO ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDEs ────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── BACKEND — Spring Boot / Maven ───────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.log
backend/logs/
backend/application-local.properties
backend/application-prod.properties
backend/src/main/resources/application-secrets.properties

# ─── BACKEND — Variables de entorno / secretos ───────────────
*.env
.env
.env.*
!.env.example

# ─── FRONTEND — Flutter ──────────────────────────────────────
frontend/flutter_app/.dart_tool/
frontend/flutter_app/.flutter-plugins
frontend/flutter_app/.flutter-plugins-dependencies
frontend/flutter_app/.packages
frontend/flutter_app/build/
frontend/flutter_app/pubspec.lock

# Flutter — plataformas generadas (no editar a mano)
frontend/flutter_app/android/.gradle/
frontend/flutter_app/android/local.properties
frontend/flutter_app/android/key.properties
frontend/flutter_app/android/app/google-services.json
frontend/flutter_app/android/captures/
frontend/flutter_app/ios/.symlinks/
frontend/flutter_app/ios/Flutter/flutter_export_environment.sh
frontend/flutter_app/ios/Flutter/Generated.xcconfig
frontend/flutter_app/ios/Pods/
frontend/flutter_app/ios/Podfile.lock
frontend/flutter_app/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/flutter_app/linux/flutter/generated_plugin_registrant.cc
frontend/flutter_app/linux/flutter/generated_plugin_registrant.h
frontend/flutter_app/linux/flutter/generated_plugins.cmake
frontend/flutter_app/windows/flutter/generated_plugin_registrant.cc
frontend/flutter_app/windows/flutter/generated_plugin_registrant.h
frontend/flutter_app/windows/flutter/generated_plugins.cmake
frontend/flutter_app/web/

# ─── LOGS Y TEMPORALES ───────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.orig
.opencode/skills/ohmyfreezer-api-integration.md
.opencode/skills/ohmyfreezer-backend.md
Documentos_oh_my_Freezer/twillio recor.txt
Documentos_oh_my_Freezer/Reto4.pdf
Documentos_oh_my_Freezer/Reto4_Final.txt
Documentos_oh_my_Freezer/Reto4_Final.docx
Documentos_oh_my_Freezer/Reto 4.txt
Documentos_oh_my_Freezer/Recetario Abrasarte.xlsx
Documentos_oh_my_Freezer/freezer.txt
Documentos_oh_my_Freezer/Construir las Builds.txt
Documentos_oh_my_Freezer/api sendgrid.txt
